<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 e successivi.

  `cloud-backup` esclude l'archivio per la stessa ragione di
  `backup_rules.xml`: i dati non lasciano il dispositivo se non dal menu Drive.

  `device-transfer` lo conserva: la migrazione verso un nuovo telefono è
  diretta, cifrata e avviata dall'utente, quindi è esattamente il caso in cui
  ritrovare le proprie schede è il comportamento atteso.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter" />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
